#
# General Makefile defintions to allow CMFGEN etc to
# be compiled and linked.
#
# NOTE WELL: 
#      FG are options for f90 files in fixed format
#      FFREE are options for f90 files in free format.
#      FD are options for f90 files in fixed format with debug.
#      FFREED are options for f90 files in free format with debug.
#      The debug commands are generally not defined, and are not used
#         unless you manually edit the Makefiles.
#
# Installation directory for CMFGEN
# Site dependent.

# Define options for the ar command. On UBUNTU systems this might be Uruv

AR_OPTION = ruv

# Detect cluster: use SLURM ClusterName, fall back to hostname prefix.
# On RAVEN (MPCDF) login nodes hostname is ravenNN; on VIPER it is viperNN.
# scontrol is the most reliable method and works on all node types.
HOST :=$(shell scontrol show config 2>/dev/null | awk '/ClusterName/ {print $$3; exit}')
ifeq ($(HOST),)
HOST :=$(shell hostname | sed 's/\(raven\|rav[a-z]\).*/raven/; s/\(viper\).*/viper/')
endif

COMPILER=intel
DEBUG=nodebug

COMPILE_OPT=$(HOST)_$(COMPILER)_$(DEBUG)

ifeq ($(HOST),crc)
INSTALL_DIR=$(HOME)/cur_cmf/
endif

ifeq ($(HOST),viper)
# Self-locating install root: this file lives at the repo top and is
# included by relative path from every level, so its own directory is
# the worktree root.  Required because ptmp1 (/ptmp) and ptmp2 are two
# git worktrees of the same repo and each must install into its own
# exe/lib/mod; a hardcoded path silently cross-installed (fedd903
# pointed builds here at the other worktree).
INSTALL_DIR:=$(realpath $(dir $(lastword $(MAKEFILE_LIST))))/
endif

ifeq ($(HOST),raven)
INSTALL_DIR:=$(realpath $(dir $(lastword $(MAKEFILE_LIST))))/
endif

ifeq ($(DEBUG),nodebug)
 MOD_DIR=$(INSTALL_DIR)mod/
 LIB_DIR=$(INSTALL_DIR)lib/
 EXE_DIR=$(INSTALL_DIR)exe/
endif

ifeq ($(DEBUG),debug)
 MOD_DIR=$(INSTALL_DIR)mod_dbg/
 LIB_DIR=$(INSTALL_DIR)lib_dbg/
 EXE_DIR=$(INSTALL_DIR)exe_dbg/
endif

ifeq ($(COMPILE_OPT),crc_gcc_nodebug)
 F90 = gfortran -fopenmp -m64 
 F90nomp = gfortran -m64
 FG  = -O -ffixed-line-length-0 -fno-backslash -fd-lines-as-comments -fbacktrace -ffpe-trap=invalid -I$(MOD_DIR) 
 FD  = -g -O0  -ffixed-line-length-0 -fbounds-check -fno-backslash -fd-lines-as-comments   -fbacktrace -I$(MOD_DIR) 
 FFREE  = -O -fno-backslash -I$(MOD_DIR) -J$(MOD_DIR)
 FFRED  = -g -fno-backslash -O0 -I$(MOD_DIR) -J$(MOD_DIR)
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
             -Wl,--no-as-needed -lmkl_gf_lp64 -lmkl_gnu_thread -lmkl_core -lgomp -lpthread -lm -ldl
 X11LIB=-L/usr/X11R6/lib -lX11
 PGLIB=-L$(PGPLOT_DIR) -lpgplot -lgfortran
endif

ifeq ($(COMPILE_OPT),crc_gcc_debug)
 F90 = gfortran -fopenmp -m64
 F90nomp = gfortran -m64
 FG  = -g -O0  -ffixed-line-length-0 -fbounds-check -fno-backslash -fd-lines-as-comments   -fbacktrace -I$(MOD_DIR) 
 FD  = -g -O0  -ffixed-line-length-0 -fbounds-check -fno-backslash -fd-lines-as-comments   -fbacktrace -I$(MOD_DIR) 
 FFREE  = -g -fno-backslash -O0 -I$(MOD_DIR) -J$(MOD_DIR)
 FFRED  = -g -fno-backslash -O0 -I$(MOD_DIR) -J$(MOD_DIR)
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
              -Wl,--no-as-needed -lmkl_gf_lp64 -lmkl_gnu_thread -lmkl_core -lgomp -lpthread -lm -ldl
 X11LIB=-L/usr/X11R6/lib -lX11
 PGLIB=-L$(PGPLOT_DIR) -lpgplot -lgfortran
endif

# Flag update (2026-09-18): -O2 -> -O3 plus
# explicit AVX-512 ISA flags and -align array64byte.
#
# ISA selection notes:
#   * -xCORE-AVX512 and -axCORE-AVX512 are NOT usable here: binaries
#     carry an Intel CPUID vendor check and refuse to start on AMD
#     ("Please verify that both the operating system and the processor
#     support ..."), verified 2026-09-17 on viper login.
#   * -xHost / -march=native DO run on this Zen4 EPYC, but trigger an
#     ifort fortcom pathology on det_r_grid_v2.f (RSS grew to 37 GB,
#     killed by OOM).  -O3 alone compiles that file in <1 s.
#   * Explicit -mavx512* feature flags emit the same AVX-512 code with
#     no vendor check and no optimizer blow-up.
#   * All general/small/interactive compute nodes (vipc/viph/vipl/vipm,
#     viper[07-08]) are 64-core/socket Zen4 EPYC like the login node
#     (scontrol CoresPerSocket=64; /proc/cpuinfo shows avx512f/dq/cd/
#     bw/vl), so AVX-512 binaries are safe on every node jobs can land
#     on.  Do NOT run these binaries on the vipa GPU nodes.
#   * -ip was tried and dropped: it added nothing over -O3 for the
#     dominant ray-integration loop and inflated compile times.
AVX512 = -mavx512f -mavx512dq -mavx512bw -mavx512vl -mavx512cd
ifeq ($(COMPILE_OPT),viper_intel_nodebug)
 F90 = ifort -qopenmp -mkl -nbs -diag-disable=10448,10412,10434
 F90nomp = ifort -mkl -nbs -diag-disable=10448,10412,10434
 FG  = -extend-source -traceback -O3 $(AVX512) -align array64byte -I$(MOD_DIR) -module $(MOD_DIR)
 FD  = -traceback -O2 -extend-source -I$(MOD_DIR)
 FFREE  = -traceback -O3 $(AVX512) -align array64byte -nbs -extend-source -I$(MOD_DIR) -module $(MOD_DIR)
 FFRED  = -nbs -traceback -O2 -I$(MOD_DIR) -extend-source -traceback -module $(MOD_DIR)
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
-Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lpthread -lm -ldl
 X11LIB=
 PGLIB=$(LIB_DIR)libpgplot_stubs.a -lgfortran
endif

ifeq ($(COMPILE_OPT),crc_intel_nodebug)
 F90 = /ihome/crc/install/intel/2020.4/compilers_and_libraries/linux/bin/intel64/ifort -qopenmp  -mkl -pg -traceback -nb
 F90nomp = /ihome/crc/install/intel/2020.4/compilers_and_libraries/linux/bin/intel64/ifort -mkl -pg -traceback   -nbs
 FG  = -traceback  -extend_source -O2 -I$(MOD_DIR)
 FD  = -g -O0  -fpe0 -check bounds  -extend_source  -traceback  -I$(MOD_DIR)
 FFREE  = -O2 -nbs -traceback -check bounds -extend_source -I$(MOD_DIR)
 FFRED  = -g -nbs -traceback -O0 -I$(MOD_DIR) -check bounds  -extend_source -traceback
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
-Wl,--no-as-needed -lmkl_gf_lp64 -lmkl_gnu_thread -lmkl_core -lgomp -lpthread -lm -ldl
 X11LIB=-L/usr/X11R6/lib -lX11
 PGLIB=-L$(PGPLOT_DIR) -lpgplot -lgfortran
endif

ifeq ($(COMPILE_OPT),viper_intel_debug)
 F90 = ifort -qopenmp -mkl -traceback -nbs
 F90nomp = ifort -mkl -traceback -nbs
 FG  = -g -O0 -check bounds -fpe-summary=none -extend_source -traceback -I$(MOD_DIR) -module $(MOD_DIR)
 FD  = -g -O0 -check bounds -fpe-summary=none -extend_source -traceback -I$(MOD_DIR)
 FFREE  = -g -nbs -traceback -O0 -I$(MOD_DIR) -check bounds -extend-source -traceback -module $(MOD_DIR)
 FFRED  = -g -nbs -traceback -O0 -I$(MOD_DIR) -check bounds -extend-source -traceback -module $(MOD_DIR)
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
-Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lpthread -lm -ldl
 X11LIB=
 PGLIB=$(LIB_DIR)libpgplot_stubs.a -lgfortran
endif

# RAVEN (MPCDF): Intel classic ifort via `module load intel/19.1.3 mkl/2020.4`
# Uses -mkl (not -qmkl) and Intel MKL interface libraries.
#
# PGPLOT is not installed on Raven.  We use a stub library
# (pgplot_stubs/pgplot_stubs.f) that provides empty implementations
# of all PGPLOT routines.  This allows all executables to link.
# Plotting tools will not produce graphical output, but the CMFGEN
# solver is completely unaffected.  Added 2026-09-07.
ifeq ($(COMPILE_OPT),raven_intel_nodebug)
 F90 = ifort -qopenmp -mkl -nbs -diag-disable=10448,10412,10434
 F90nomp = ifort -mkl -nbs -diag-disable=10448,10412,10434
 FG  = -extend-source -traceback -O3 $(AVX512) -align array64byte -I$(MOD_DIR) -module $(MOD_DIR)
 FD  = -traceback -O2 -extend-source -I$(MOD_DIR)
 FFREE  = -traceback -O3 $(AVX512) -align array64byte -nbs -extend-source -I$(MOD_DIR) -module $(MOD_DIR)
 FFRED  = -nbs -traceback -O2 -I$(MOD_DIR) -extend-source -traceback -module $(MOD_DIR)
 BLAS=
 LAPACK= -lmkl_blas95_lp64 -lmkl_lapack95_lp64 \
-Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lpthread -lm -ldl
 X11LIB=
 PGLIB=$(LIB_DIR)libpgplot_stubs.a -lgfortran
endif

ifeq ($(COMPILE_OPT),raven_intel_debug)
 F90 = ifort -qopenmp -mkl -traceback -nbs
 F90nomp = ifort -mkl -traceback -nbs
 FG  = -g -O0 -check bounds -fpe-summary=none -extend_source -traceback -I$(MOD_DIR) -module $(MOD_DIR)
 FD  = -g -O0 -check bounds -fpe-summary=none -extend_source -traceback -I$(MOD_DIR)
