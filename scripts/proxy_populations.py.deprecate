#!/usr/bin/env python3
"""Generate proxy population _IN files for CMFGEN using dilute LTE (Saha-Boltzmann
with radiation dilution factor W). Parses SN_HYDRO_DATA and F_OSCDAT atomic data
files, computes departure coefficients, and writes _IN files compatible with
CMFGEN's REGRID_LOG_DC_V1 subroutine."""

import argparse
import os
import re
import sys
import math
import numpy as np
from pathlib import Path
from datetime import datetime
from collections import defaultdict

# Physical constants
HDKT = 4.7994145          # h/k_B in units of (10^15 Hz)^{-1} * (10^4 K)
SPEED_LIGHT = 2.9979248e10 # cm/s
M_H = 1.6733e-24           # hydrogen mass in grams


def detect_lte_floor_from_vadat(model_dir):
    """Auto-detect whether LTE-at-T_local (--lte-floor) is the correct proxy_populations mode
    by reading the VADAT file that prepare_VADAT.py has already written.

    With USE_LAM_ES=T (J=B(T_local)) and FIX_T=T, the radiation field is thermal
    at T_local. LTE at T_local is the correct starting point — NLTE-aware mode
    would write T_ion != T_local, causing huge initial corrections.

    With USE_LAM_ES=F (full moment solver), J is solved self-consistently and
    can differ from B(T_local). NLTE-aware mode (default) is appropriate.

    Returns True if LTE-at-T_local is recommended, False for NLTE-aware.
    Prints a diagnostic message explaining the decision.
    """
    vadat_path = os.path.join(model_dir, 'VADAT')
    if not os.path.exists(vadat_path):
        print(f"[Auto-detect] VADAT not found at {vadat_path} — defaulting to NLTE-aware mode")
        return False

    use_lam_es = None
    fix_t = None
    with open(vadat_path) as f:
        for line in f:
            if '[USE_LAM_ES]' in line:
                use_lam_es = line.strip().split()[0].upper() == 'T'
            elif '[FIX_T]' in line:
                fix_t = line.strip().split()[0].upper() == 'T'

    if use_lam_es is None or fix_t is None:
        print(f"[Auto-detect] Could not read USE_LAM_ES or FIX_T from VADAT — defaulting to NLTE-aware mode")
        return False

    if use_lam_es and fix_t:
        print(f"[Auto-detect] USE_LAM_ES=T + FIX_T=T → J=B(T_local). Using LTE-at-T_local (--lte-floor mode).")
        print(f"  NLTE-aware mode would write T_ion != T_local, mismatching the CMFGEN radiation field.")
        return True
    else:
        print(f"[Auto-detect] USE_LAM_ES={use_lam_es} + FIX_T={fix_t} → J may differ from B(T_local).")
        print(f"  Using NLTE-aware mode (dilute Saha at T_ion with W dilution).")
        return False
L_SUN = 3.828e33           # erg/s
SIGMA_SB = 5.670374e-5     # Stefan-Boltzmann constant (erg/s/cm^2/K^4)

# Species to element mapping: species_name -> (element_label, atomic_mass, ion_stage)
# ion_stage: 1=neutral, 2=singly ionized, 3=doubly ionized
# Kept for backwards compatibility and as an explicit override cache.
_SPECIES_MAP = {
    'HI':    ('HYD',  1.0,  1),
    'HeI':   ('HE',   4.0,  1),
    'CI':    ('CARB',12.0,  1),
    'C2':    ('CARB',12.0,  2),
    'OI':    ('OXY', 16.0,  1),
    'O2':    ('OXY', 16.0,  2),
    'SkI':   ('SIL', 28.1,  1),
    'Sk2':   ('SIL', 28.1,  2),
    'CaI':   ('CAL', 40.1,  1),
