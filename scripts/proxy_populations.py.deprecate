    'CaIII': ('CAL', 40.1,  3),
    'FeI':   ('IRON',55.8,  1),
    'Fe2':   ('IRON',55.8,  2),
    'FeIII': ('IRON',55.8,  3),
    'FeIV':  ('IRON',55.8,  4),
    'FeV':   ('IRON',55.8,  5),
}

# Atomic properties for MODEL file generation from MODEL_SPEC
# species_name -> (Z, Gion, At_No)
# Kept for backwards compatibility and as an explicit override cache.
_SPECIES_ATOMIC = {
    'HI':    (1.0,  1.0,  1.0),
    'HeI':   (1.0,  2.0,  2.0),
    'CI':    (1.0,  2.0,  6.0),
    'C2':    (2.0,  1.0,  6.0),
    'OI':    (1.0,  4.0,  8.0),
    'O2':    (2.0,  9.0,  8.0),
    'SkI':   (1.0,  2.0, 14.0),
    'Sk2':   (2.0,  1.0, 14.0),
    'CaI':   (1.0,  2.0, 20.0),
    'Ca2':   (2.0,  1.0, 20.0),
    'CaIII': (3.0,  1.0, 20.0),
    'FeI':   (1.0, 10.0, 26.0),
    'Fe2':   (2.0,  9.0, 26.0),
    'FeIII': (3.0,  6.0, 26.0),
    'FeIV':  (4.0,  1.0, 26.0),
