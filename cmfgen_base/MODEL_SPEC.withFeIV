122 [ND]                !Number of depth points
8   [NC]                !Number of core rays
130 [NP]                !Number of impact parameters [ND+NC]
1 [NUM_BNDS]          !1=DIAG for N_TYPE=G_ONLY; 3=TRIDIAG for N_ON_J
150000         [NCF_MAX]           !Total number of frequencies
350            [MAX_SIM]           !Max # overlapping Doppler line profiles
80000          [NLINE_MAX]         !Maximum # of bound-bound transitions
21             [NLF]               !For CMF option only
!
! Model atom for Type IIb/IIn (SN2024pba) - original CMFGEN functionality
! Elements: H, He, O, Si, Ca, Fe + radioactive Ni/Co
! ISF format: NV,NS,NF where NV=important vars, NS=super, NF=full
! When NV=NS=NF: no superlevel grouping, all levels are NLTE
! Species: HI, HeI, OI, SkI, Sk2, CaI, Ca2, FeI, Fe2, FeIII, FeIV
! Ghost species removed: C, N, O II-VI, Si III-VI, Fe V-VII
!   (TRANS_ entries caused CMFGEN to solve species without ISF entries)
!   FeIV (1,1,1) re-added as ionization sink for FeIII: at T=12000K,
!   FeIV/FeIII ~ 4% (Saha), closes the FeIII ionization balance.
!
12,12,12        [HI_ISF]             !H I: n=1-12 (same as X, converges)
5,5,5           [HeI_ISF]            !He I: 5 NLTE (same as X, n=3+ causes blowups)
10,14,30        [OI_ISF]             !O I: 10 NLTE, 14 super, 30 full (same as X)
1,1,1           [SkI_ISF]            !Si I: ground state (same as X, trace species)
10,10,10        [Sk2_ISF]            !Si II: 10 NLTE (same as X, SL=80 bypass)
1,1,1           [CaI_ISF]            !Ca I: ground state (same as X, trace species)
12,12,12        [Ca2_ISF]            !Ca II: 12 NLTE (same as X)
1,1,1           [FeI_ISF]            !Fe I: ground state (same as X, trace species)
10,22,80         [Fe2_ISF]            !Fe II: 10 NLTE, 22 super, 80 full (expanded from X 50)
1,3,10           [FeIII_ISF]          !Fe III: ground state NLTE only (NS=3 matches f_to_s_105 max SL link); 5,24,80 caused super-level divergence (NT=110 cap, FeIII SL pops oscillating 0.999<->1e21)
1,1,1            [FeIV_ISF]           !Fe IV: ground state only — ionization sink for FeIII (Saha: FeIV/FeIII~4% at 12000K)
