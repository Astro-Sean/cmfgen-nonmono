58,58,58       [OI_ISF]              !O I: 2 ionization stages
264,264,493    [SkI_ISF]             !Si I: 2 ionization stages
79,79,157      [Sk2_ISF]             !Si II: 2 ionization stages
30,30,30       [CaI_ISF]             !Ca I: 2 ionization stages
30,30,30       [Ca2_ISF]             !Ca II: 2 ionization stages
181,181,1579   [FeI_ISF]             !Fe I-V: 6 ionization stages (Dessart+2015)
135,135,2698   [Fe2_ISF]             !Fe II
105,105,1500   [FeIII_ISF]           !Fe III
