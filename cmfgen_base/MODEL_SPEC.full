150 [ND]                !Number of depth points
8   [NC]                !Number of core rays
165 [NP]                !Number of impact parameters [ND+NC]
1 [NUM_BNDS]          !1 = diagonal (DIAG) for N_TYPE=G_ONLY; 3 = tridiagonal for N_ON_J
150000         [NCF_MAX]           !Total number of frequencies
350            [MAX_SIM]           !Maximum # of lines whose Doppler profile overlpas.
120000         [NLINE_MAX]         !Maximum # of bound-bound transitions
21             [NLF]               !For CMF option only

