! ADJUST_R_DEFAULTS - Runtime R-grid refinement (base default: disabled)
! Format: value BEFORE [KEY] (same as VADAT).
! prepare_VADAT.py overwrites this with N_ITS>0 when REV_RGRID=T.
!
         0 [N_ITS]
! Number of grid revisions to perform (0 = disabled)
         1 [STRT_ITS]
! First iteration to start grid revision (ignored when N_ITS=0)
        10 [FREQ_ITS]
! Frequency of grid revisions (every N iterations; ignored when N_ITS=0)
TAU_SPACE [GRID_METH]
! Regridding method: TAU_SPACE, VEL_SPACE, FULL_R, OB_ONLY
REFINE [GRID_TYPE]
! Grid type: UNIFORM, MODUN, FIX_NX, REFINE, VTAU
  -2.0D0 [FG_MIN]
! Min log(Tau) for fine grid: targets tau~0.01 (deep ejecta)
   0.5D0 [FG_MAX]
! Max log(Tau) for fine grid: up to tau~3 (shock front region)
! Parameters for outer/inner boundary handling
DEFAULT [OB_OPT]
! Outer boundary option: DEFAULT or SPECIFY
DEFAULT [IB_OPT]
! Inner boundary option: DEFAULT or SPECIFY
