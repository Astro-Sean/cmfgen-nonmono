!--- 8. Bound-bound & blanketing ---
! Line-list filters: GF_CUT drops weak lines; AT_CUT and MIN_TRANS
! trim the number of transitions retained per ion.
! [OPT] MIX_COH changed T->F:
!   Mixed coherent scattering adds off-diagonal coupling in the
!   electron scattering redistribution.  For a first convergence pass
!   disabling it simplifies the scattering source function and reduces
!   the number of iterations needed to establish J.  Re-enable for
!   the final spectrum calculation.
! [OPT] ES_FAC reduced 1.0->0.8:
!   Slightly under-weighting electron scattering in early iterations
!   damps the coherent-scattering oscillation that commonly stalls
!   convergence in high-VINF models.  Return to 1.0 for final run.
SOB             [GLOBAL_LINE]  ! Sobolev rates
2.0D-3          [GF_CUT] ! discard lines weaker than this normalized gf-cut
9               [GF_LEV_CUT]   ! Apply GF_CUT above this level
10              [AT_CUT] ! apply GF_CUT only to species with atomic number >= this
9               [MIN_TRANS] ! discard levels with fewer bound-bound transitions than this
F               [THK_LINE]     ! Thick-line outer BC off
T               [CHK_L_POS]    ! Prevent negative total opacity
SRCE_CHK        [NEG_OPAC_OPT] ! Limit source when chi negative
F               [He2_RES=0]    ! Required key (hardcoded in source); He II not in species list
T               [ALLOW_OL]     ! [OPT] was F; line overlap for dense IIn CSM (geometric, not thermal)
50.0D0          [OL_DIF]       ! Velocity sep for overlaps (km/s)
T               [SCL_LN]       ! Ignore lines in continuum opacity
0.1D0           [SCL_LN_FAC]   ! Line scale-out limit (Doppler frac)
F               [SCL_SL_OPAC]  ! No separate SL opacity scaling
F               [OLD_J]        ! Old J option off
F               [MIX_COH]      ! [OPT] was T; disable for convergence phase (simpler ES source fn)
0.6D0           [ES_FAC] ! electron-scattering source weight (only used when MIX_COH=T)

