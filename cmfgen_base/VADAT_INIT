!--- 4. Radiation-field solver ---
! USE_LAM_ES=T (J=TC formal solution): J set directly from source function,
! bypassing moment equations entirely (comp_j_blank.f:727: RJ=TC).
! Preferred for non-monotonic velocity: avoids MOM_JREL_V9's sigma cap at
! -0.999 which causes instabilities when sigma < -1 at velocity reversals.
! USE_J_REL=F: MOM_JREL_V9 disabled.
! INCL_REL=F: required when USE_J_REL=F (CMFGEN check_param_consistency.f).
! N_TYPE=N_ON_J: N/J Eddington factor. J is always > 0 from the formal solution,
! so N/J is well-defined even at velocity reversals where H=0.
! G_ONLY (N/H) is undefined when H=0 at velocity reversals — unstable.
! CHK_J=ABS_VAL patches negative J at shock fronts.
! Non-monotonic velocity handled by Sobolev line code (Dessart+2015
! prescription: max(|1+sigma*mu^2|, -0.2*(1+sigma)) for sigma < 0).
F               [USE_J_REL]    ! Off: MOM_JREL_V9 disabled (sigma cap causes instabilities for non-monotonic V)
F               [USE_JREL]     ! Stale keyword (not read by CMFGEN)
T               [USE_LAM_ES]   ! On: J=TC formal solution (bypasses moment equations for non-monotonic V)
F               [USE_FRM_REL]  ! No relativistic formal solution (required: USE_J_REL=F)
F               [INCL_REL]     ! No relativistic terms (required: USE_J_REL=F per check_param_consistency.f)
F               [INCL_ADV_TRANS] ! No advection terms (static snapshot)
F               [INCL_DJDT]    ! dJ/dt off (static)
F               [USE_DJDT_RTE] ! DJ/Dt routines off (static_snapshot: steady state)
F               [JC_W_EDD]     ! EDDFACTOR ACCESS=DIRECT (off for init; T in final if needed)
F               [JBAR_W_EDD]   ! Line continuum J from Eddington factors off
T               [DIF]          ! Diffusion at inner boundary
DIFFUSION       [IB_METH]      ! Inner boundary method
F               [COH_ES]       ! Non-coherent electron scattering (Dessart+2015: incoherent Thomson for line wings)
N_ON_J           [N_TYPE]       ! N/J Eddington factor (J>0 always; stable at velocity reversals where H=0)
INT/INS         [FG_OPT]       ! Integral short characteristics
ABS_VAL         [CHK_J]        ! Patch negative J at shock fronts (|J|/10); fixes NaN from FORM_VAL cold-start
SET_POS         [CHK_XM]       ! Non-negative source function
MAX_VAL         [CHK_H]        ! Check |H| <= J
F               [CHK_NG]       ! Ng check off

!--- 5. Radiation field params ---
! [OPT] VFRAC_FG / VFRAC_MOM: RT grid resolution parameters (Doppler-width fractions).
!   VFRAC_MOM: max velocity spacing for moment solver (MOM_J_CMF_V11). If
!     |V(I)-V(I+1)| > VFRAC_MOM * min(VDOP_VEC), extra RT grid points are inserted.
!     VFRAC_MOM=0 is INVALID (division by zero). Does NOT modify the velocity field.
!   VFRAC_FG: analogous for the formal-solution ray solver (FG_J_CMF_V10).
!   prepare_VADAT.py auto-computes VFRAC_MOM from the hydro velocity profile.
!   Coarser velocity spacing reduces computational cost while maintaining
!   sufficient accuracy for complex SN models and prevents ND adjustment.
! [OPT] ACC_F relaxed to 1e-2:
!   The Eddington factor loop convergence; 1e-2 is stable for DIAG solver.
! [OPT] N_IB_INS / N_OB_INS raised to 15:
!   Extra boundary points smooth the large opacity gradient at the
!   shock interface, stabilising the inner-boundary diffusion condition.
ZERO            [METHOD]       ! Continuum tau method
ZERO            [LUM_METH]     ! L from ETA
0.50D0          [VFRAC_FG]     ! [OPT] was 0.4; coarser ray spacing for SN (prevents ND adjustment)
0.50D0          [VFRAC_MOM]    ! [OPT] was 0.4; coarser RT grid for SN (prevents ND adjustment)
F               [THK_CONT]     ! No incident radiation at outer boundary
T               [TRAP_J]       ! Trapezoidal weights for J,H,K,N
T               [COMP_F]       ! Compute Eddington factors at start
1.0D-02         [ACC_F]        ! [OPT] was 5e-3; relaxed Eddington convergence for DIAG stability
15              [N_IB_INS]     ! More boundary points for DIAG solver stability (was 10; CMFGEN limit is 16)
15              [N_OB_INS]     ! More boundary points for DIAG solver stability (was 10; CMFGEN limit is 16)
0.0D0           [REXT_FAC]     ! No R-grid extension

!--- 6. Line broadening ---
! [OPT] MAX_DOP raised 6->8:
!   At VINF=10472 km/s lines overlap strongly; a wider resonance zone
!   prevents opacity gaps between adjacent lines during the line-transfer step.
! [OPT] FRAC_DOP raised 1.0->1.5:
!   Coarser in-resonance sampling is consistent with the larger Doppler
!   widths and reduces the total number of frequency quadrature points.
! [OPT] dV_CMF_PROF coarsened 200->500 km/s:
!   VINF=10472 means line cores span ~20000 km/s; 500 km/s still gives
!   ~40 points across the profile while cutting the CMF frequency array
!   by 2.5x, directly reducing BA matrix assembly time.
! [OPT] dV_CMF_WING coarsened 300->800 km/s:
!   Wing regions need less resolution; 800 km/s matches the coarser
!   profile sampling and avoids redundant frequency points.
! [OPT] ES_WING_EXT raised 2500->12000 km/s:
!   Non-coherent ES wings must extend beyond VINF=10472 km/s.
!   The previous value of 2500 km/s truncated the wings far inside VINF,
!   causing missing flux in the ES redistribution and forcing extra
!   Lambda iterations to compensate.  12000 km/s provides safe margin.
! [OPT] R_CMF_WING_EXT raised 3.0->4.0:
!   Coherent ES wing in VINF units; larger VINF requires wider coverage.
T               [FIX_DOP]      ! Fixed Doppler width
4.0D0           [TDOP]         ! Doppler T (10^4 K) — irrelevant when AMASS_DOP=1e40
1.0D+40         [AMASS_DOP]    ! Manual: "set AMASS_DOP=1.0D+40, use VTURB to control width"
20.0D0          [VTURB]        ! Dessart+2015: 20 km/s turbulent velocity (controls line width)
8.0D0           [MAX_DOP]      ! [OPT] was 6.0; wider resonance zone
1.5D0           [FRAC_DOP]     ! [OPT] was 1.0; coarser in-resonance sampling
80.0D0          [dV_CMF_PROF]  ! [OPT] was 200; resolve 100 km/s features
200.0D0         [dV_CMF_WING]  ! [OPT] was 300; resolve 100 km/s features
12000.0D0       [ES_WING_EXT]  ! [OPT] was 2500; MUST exceed VINF=10472 km/s
4.0D0           [R_CMF_WING_EXT] ! [OPT] was 3.0; wider coherent ES wing

