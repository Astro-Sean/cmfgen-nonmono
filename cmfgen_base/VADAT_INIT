!--- 15. Linearisation & BA ---
! SOL_METH=DIAG: consistent with N_TYPE=N_ON_J (NUM_BNDS=1).
! Each depth solved independently (DGETRF/DGETRS). No inter-depth coupling.
! Slower convergence but more stable - no error propagation across shock regions.
DIAG            [SOL_METH] ! depth-independent diagonal linearization solver
MAJOR           [SCALE_OPT]    ! Limit per-depth max change
5.0D-02         [EPS_TERM] ! iterate until the max % population change falls below this
5.0D0           [MAX_LIN] ! max correction factor allowed per linearization step
1.0D10          [MAX_LAM]      ! 1e10 - user directive 15-Sep-2026 (was 1.05); effectively unclamped Lambda steps
1.0D150         [MAX_CHNG] ! abort if a correction exceeds this % change; MAX_LAM is the real limiter
T               [COMP_BA]      ! Recompute BA each time
F               [STORE_BA_INV] ! do not store the BA inverse on disk
F               [WR_PRT_INV] ! do not write the partial BA inverse
T               [STORE_BA]     ! Store BA on disk (BAMAT)
2               [N_FIX_BA] ! recompute the BA matrix every N iterations
1.0D-05         [BA_CHK_FAC] ! fractional accuracy demanded of the BA solution
1.0D1           [FIX_BA] ! switch to BA solver once max % change falls below this
2.0D2           [LAM_VAL] ! keep Lambda-iterating while max % change exceeds this
2               [NUM_LAM] ! Lambda iterations between full linearizations
F               [RD_SOL]       ! Do not read external solution

!--- 16. Spatial grid ---
! [OPT] INC_GRID T->F:
!   The enhanced grid (N_INS extra points between every depth) multiplies
!   the effective grid size by (1+N_INS) in the insertion region.  For
!   ND_QUAD=50 and N_INS=2 this adds 100 extra quadrature depths that
!   are interpolated; at VINF=10472 km/s the velocity gradient is steep
!   enough that the interpolated opacities can introduce artefacts.
!   RD_IN_R_GRID=T requires an RDINR file (see OLD/SN11); F builds R from SN_HYDRO_DATA.
!   Re-enable INC_GRID=T only if outer-boundary J instability is seen.
! [OPT] ND_QUAD reduced 50->30:
!   Fewer quadrature depths at the inner boundary reduces the cost of
!   the formal solution without affecting the accuracy of the Eddington
!   factors, which are dominated by the outer region.
! N_PAR=2000: frequencies solved between BA matrix rebuilds.
F               [INC_GRID]     ! SNA stable setting
F               [ALL_FREQ] ! apply the grid-accuracy test only where needed, not at all nu
2.0D0           [ACC_END]      ! Min nu for enhanced grid (10^15 Hz)
2               [N_INS]        ! Extra depths (if INC_GRID=T)
1               [ST_INT]       ! First depth for insertion
30              [END_INT]      ! Last depth for insertion
30              [ND_QUAD]      ! [OPT] was 50; fewer inner quadrature depths
LOG             [INTERP_TYPE]  ! Log R interpolation
2000            [N_PAR]  ! frequency intervals between BA recomputations

