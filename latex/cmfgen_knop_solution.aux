\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Why monotonic velocity matters. \emph  {Top}: velocity profiles. \emph  {Bottom}: the comoving-frame frequency a fixed observer-frequency photon experiences as it travels along a ray. In a monotonic outflow (left) the CMF frequency decreases smoothly and crosses each line rest frequency $\nu _0$ exactly once. In a compression zone (right, shaded) the photon is \emph  {blueshifted}: $\nu _{\rm  CMF}$ turns around and crosses $\nu _0$ three times, creating three resonance points the original solver did not know how to handle.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:crossings}{{1}{3}{Why monotonic velocity matters. \emph {Top}: velocity profiles. \emph {Bottom}: the comoving-frame frequency a fixed observer-frequency photon experiences as it travels along a ray. In a monotonic outflow (left) the CMF frequency decreases smoothly and crosses each line rest frequency $\nu _0$ exactly once. In a compression zone (right, shaded) the photon is \emph {blueshifted}: $\nu _{\rm CMF}$ turns around and crosses $\nu _0$ three times, creating three resonance points the original solver did not know how to handle}{figure.1}{}}
\newlabel{eq:shortchar}{{5}{3}{Folding the frequency drift into a fake opacity}{equation.3.5}{}}
