\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Initial STELLA input structure of \texttt  {T6k\_M10.0\_V10000}: density (top), velocity (middle) and mass fractions (bottom) versus radius. Shading marks the SN$_{\mathrm  {B}}$\ shell (teal), the wind gap (blue), the wind$\rightarrow $ejecta buffer (orange) and the metal-rich SN$_{\mathrm  {A}}$\ ejecta (purple). The ejecta carries the He/C/O/Si/Ca/Fe reservoir whose radiative heating is the key spectral hypothesis.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:input}{{5}{7}{Initial STELLA input structure of \texttt {T6k\_M10.0\_V10000}: density (top), velocity (middle) and mass fractions (bottom) versus radius. Shading marks the \SNb \ shell (teal), the wind gap (blue), the wind$\rightarrow $ejecta buffer (orange) and the metal-rich \SNa \ ejecta (purple). The ejecta carries the He/C/O/Si/Ca/Fe reservoir whose radiative heating is the key spectral hypothesis}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \texttt  {T6k\_M10.0\_V10000} $R$-band (solid) and bolometric (dashed) lightcurve versus the observed $r$ and ATLAS $o$ photometry, phased to each curve's own maximum (model bands are Johnson--Cousins; systematic offsets of 0.1--0.3\nobreakspace  {}mag vs.\ SDSS/ATLAS are expected). The model reproduces the two-component morphology: a $\sim -16.3$\nobreakspace  {}mag cooling/diffusion bump followed by a $\sim -19.4$\nobreakspace  {}mag interaction-powered main peak.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:model_lc}{{6}{8}{\texttt {T6k\_M10.0\_V10000} $R$-band (solid) and bolometric (dashed) lightcurve versus the observed $r$ and ATLAS $o$ photometry, phased to each curve's own maximum (model bands are Johnson--Cousins; systematic offsets of 0.1--0.3~mag vs.\ SDSS/ATLAS are expected). The model reproduces the two-component morphology: a $\sim -16.3$~mag cooling/diffusion bump followed by a $\sim -19.4$~mag interaction-powered main peak}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Grid parameters and their established lightcurve roles.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:grid}{{2}{8}{Grid parameters and their established lightcurve roles}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Radial structure of \texttt  {T6k\_M10.0\_V10000} from the STELLA \texttt  {.swd} at $t=20$, 40, 57 and 75\nobreakspace  {}d after shell launch (colour-coded). Top: density. Middle: velocity. Bottom: gas temperature (solid) and radiation temperature (dotted). Dashed vertical lines mark the inner edge of the O-rich SN$_{\mathrm  {A}}$\ ejecta ($X_{\rm  O}>0.05$); dotted lines mark the largest velocity discontinuity inside it (the embedded shock). The ejecta face is heated radiatively while its velocity field remains homologous.}}{9}{figure.7}\protected@file@percent }
\newlabel{fig:heating}{{7}{9}{Radial structure of \texttt {T6k\_M10.0\_V10000} from the STELLA \texttt {.swd} at $t=20$, 40, 57 and 75~d after shell launch (colour-coded). Top: density. Middle: velocity. Bottom: gas temperature (solid) and radiation temperature (dotted). Dashed vertical lines mark the inner edge of the O-rich \SNa \ ejecta ($X_{\rm O}>0.05$); dotted lines mark the largest velocity discontinuity inside it (the embedded shock). The ejecta face is heated radiatively while its velocity field remains homologous}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Grid lightcurves (model $V$ or bolometric magnitude, phased to each model's own peak) versus the observed $r$-band and ATLAS $o$ photometry. Shell kinetic energy sets the peak height, the wind column the post-peak decline, and \texttt  {we\_transition\_dex} the sharpness of the rise. Some \texttt  {X\_*} runs are still in progress; truncated curves reflect completed STELLA time only.}}{10}{figure.8}\protected@file@percent }
\newlabel{fig:grid}{{8}{10}{Grid lightcurves (model $V$ or bolometric magnitude, phased to each model's own peak) versus the observed $r$-band and ATLAS $o$ photometry. Shell kinetic energy sets the peak height, the wind column the post-peak decline, and \texttt {we\_transition\_dex} the sharpness of the rise. Some \texttt {X\_*} runs are still in progress; truncated curves reflect completed STELLA time only}{figure.8}{}}
