\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ATLAS $o$- (orange) and $c$-band (cyan) lightcurve of SN\nobreakspace  {}2024pba in absolute magnitude ($D_L=80.4$\nobreakspace  {}Mpc, $E(B{-}V)=0.15$). Dashed lines mark the adopted anchors: SN$_{\mathrm  {A}}$\ explosion ($\sim $MJD\nobreakspace  {}60490, constrained by the ATLAS rise), SN$_{\mathrm  {A}}$\ peak (60513), and the SN$_{\mathrm  {B}}$\ main peak (60850). The grey band marks the precursor-bump window, $\sim $30--40\nobreakspace  {}d before the main peak. A few bad-subtraction outliers have been removed.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:obs_lc}{{1}{2}{ATLAS $o$- (orange) and $c$-band (cyan) lightcurve of SN~2024pba in absolute magnitude ($D_L=80.4$~Mpc, $E(B{-}V)=0.15$). Dashed lines mark the adopted anchors: \SNa \ explosion ($\sim $MJD~60490, constrained by the ATLAS rise), \SNa \ peak (60513), and the \SNb \ main peak (60850). The grey band marks the precursor-bump window, $\sim $30--40~d before the main peak. A few bad-subtraction outliers have been removed}{figure.1}{}}
