\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Observed spectra of SN\nobreakspace  {}2024pba, rest-frame ($z=0.0186$), normalised to the 5000--7000\nobreakspace  {}\r A\ median. Top: Palomar DBSP spectrum at MJD\nobreakspace  {}60523.5, ten days after the SN$_{\mathrm  {A}}$\ peak. Bottom: NOT ALFOSC spectrum at MJD\nobreakspace  {}60875.1, 25\nobreakspace  {}d after the SN$_{\mathrm  {B}}$\ main peak. Grey lines mark the rest wavelengths of the key H, He, O, Si, Ca and Fe features.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:spectra}{{2}{4}{Observed spectra of SN~2024pba, rest-frame ($z=0.0186$), normalised to the 5000--7000~\AA \ median. Top: Palomar DBSP spectrum at MJD~60523.5, ten days after the \SNa \ peak. Bottom: NOT ALFOSC spectrum at MJD~60875.1, 25~d after the \SNb \ main peak. Grey lines mark the rest wavelengths of the key H, He, O, Si, Ca and Fe features}{figure.2}{}}
