\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic of the two-event geometry at SN$_{\mathrm  {B}}$\ shell launch (SN$_{\mathrm  {A}}$\ age $\approx 400$\nobreakspace  {}d; the wind$\rightarrow $ejecta buffer is omitted for clarity). From inside out: the SN$_{\mathrm  {B}}$\ shell (solar composition, $M_{\rm  sh}\approx 5$--$10\nobreakspace  {}\ensuremath  {M_\odot }$, $v_{\rm  sh}\approx 10^4$\nobreakspace  {}\ensuremath  {\mathrm  {km\,s^{-1}}}); the wind gap ($\rho \propto r^{-2}$); and the metal-rich, homologously expanding SN$_{\mathrm  {A}}$\ ejecta. The forward shock (red) sits at the shell/wind interface; the orange hatching marks the radiatively heated material ahead of it, with the heating declining with distance from the interface. The SN$_{\mathrm  {A}}$\ ejecta is heated radiatively, not shocked.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:schematic}{{3}{5}{Schematic of the two-event geometry at \SNb \ shell launch (\SNa \ age $\approx 400$~d; the wind$\rightarrow $ejecta buffer is omitted for clarity). From inside out: the \SNb \ shell (solar composition, $M_{\rm sh}\approx 5$--$10~\Msun $, $v_{\rm sh}\approx 10^4$~\kms ); the wind gap ($\rho \propto r^{-2}$); and the metal-rich, homologously expanding \SNa \ ejecta. The forward shock (red) sits at the shell/wind interface; the orange hatching marks the radiatively heated material ahead of it, with the heating declining with distance from the interface. The \SNa \^^Mejecta is heated radiatively, not shocked}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SN$_{\mathrm  {A}}$\ model \texttt  {SN\_A\_g\_T20k\_Ni06} $R$-band (solid) and bolometric (dashed) lightcurve, with the explosion epoch aligned to MJD\nobreakspace  {}60490, compared to the observed $r$, $g$ and ATLAS $o$ photometry around the first peak. The model reaches $M_R\approx -17.3$, close to the observed $-17.2$; the early bright phase is shock breakout through the extended envelope.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:sn_a_lc}{{4}{6}{\SNa \ model \texttt {SN\_A\_g\_T20k\_Ni06} $R$-band (solid) and bolometric (dashed) lightcurve, with the explosion epoch aligned to MJD~60490, compared to the observed $r$, $g$ and ATLAS $o$ photometry around the first peak. The model reaches $M_R\approx -17.3$, close to the observed $-17.2$; the early bright phase is shock breakout through the extended envelope}{figure.4}{}}
