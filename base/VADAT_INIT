0.6D0           [VFRAC_FG]     ! Coarser ray spacing for J(mom)/J(ray) stability
0.6D0           [VFRAC_MOM]    ! Coarser moment spacing for J(mom)/J(ray) stability
F               [THK_CONT]     ! No incident radiation at outer boundary
T               [TRAP_J]       ! Trapezoidal weights for J,H,K,N
T               [COMP_F]       ! Compute Eddington factors at start
5.0D-03         [ACC_F]        ! [OPT] was 1e-2; tighter Eddington convergence
30              [N_IB_INS]     ! SNA stable setting
30              [N_OB_INS]     ! SNA stable setting
0.0D0           [REXT_FAC]     ! No R-grid extension

!--- 6. Line broadening ---
! [OPT] MAX_DOP raised 6->8:
!   At VINF=10472 km/s lines overlap strongly; a wider resonance zone
!   prevents opacity gaps between adjacent lines during the line-transfer step.
! [OPT] FRAC_DOP raised 1.0->1.5:
!   Coarser in-resonance sampling is consistent with the larger Doppler
!   widths and reduces the total number of frequency quadrature points.
! [OPT] dV_CMF_PROF coarsened 200->500 km/s:
!   VINF=10472 means line cores span ~20000 km/s; 500 km/s still gives
!   ~40 points across the profile while cutting the CMF frequency array
!   by 2.5x, directly reducing BA matrix assembly time.
! [OPT] dV_CMF_WING coarsened 300->800 km/s:
!   Wing regions need less resolution; 800 km/s matches the coarser
!   profile sampling and avoids redundant frequency points.
! [OPT] ES_WING_EXT raised 2500->12000 km/s:
!   Non-coherent ES wings must extend beyond VINF=10472 km/s.
!   The previous value of 2500 km/s truncated the wings far inside VINF,
!   causing missing flux in the ES redistribution and forcing extra
!   Lambda iterations to compensate.  12000 km/s provides safe margin.
! [OPT] R_CMF_WING_EXT raised 3.0->4.0:
!   Coherent ES wing in VINF units; larger VINF requires wider coverage.
T               [FIX_DOP]      ! Fixed Doppler width
4.0D0           [TDOP]         ! Doppler T (10^4 K)
4.0D0           [AMASS_DOP]    ! Atomic mass for Doppler (amu)
20.0D0          [VTURB]        ! Microturbulence (km/s)
8.0D0           [MAX_DOP]      ! [OPT] was 6.0; wider resonance zone
1.5D0           [FRAC_DOP]     ! [OPT] was 1.0; coarser in-resonance sampling
80.0D0          [dV_CMF_PROF]  ! [OPT] was 200; resolve 100 km/s features
200.0D0         [dV_CMF_WING]  ! [OPT] was 300; resolve 100 km/s features
12000.0D0       [ES_WING_EXT]  ! [OPT] was 2500; MUST exceed VINF=10472 km/s
4.0D0           [R_CMF_WING_EXT] ! [OPT] was 3.0; wider coherent ES wing

